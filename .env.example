# =============================================================================
# RME-License-Hub — contoh environment (salin ke .env dan isi nilai nyata).
# Semua nilai rahasia (APP_KEY, *_SECRET, kunci RSA) WAJIB digenerate, jangan
# pakai placeholder. Lihat DEPLOYMENT.md untuk langkah generate.
# =============================================================================

# --- Aplikasi --------------------------------------------------------------
APP_NAME="RME License Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hub.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database (MariaDB / MySQL) -------------------------------------------
# Di docker-compose, host = "hub-db"; di host baremetal isi 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=hub-db
DB_PORT=3306
DB_DATABASE=rme_license_hub
DB_USERNAME=hub
DB_PASSWORD=
# Hanya untuk setup awal root (tidak dipakai aplikasi sehari-hari).
DB_ROOT_PASSWORD=

# --- Session / Cache / Queue ---------------------------------------------
# database: dipakai oleh admin dashboard hub (lihat migrations sessions table).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=redis
# CACHE_PREFIX=

# Queue: redis (disarankan untuk retry webhook & grup). "database" juga aman.
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb

# --- Redis -----------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=hub-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# --- Mail (notifikasi admin: lisensi kedaluwarsa, force-disable, dll) ------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- License signing (RSA key pair) --------------------------------------
# Digenerate dengan: php artisan license:keys:generate  (atau openssl manual).
# Public key didistribusikan ke RME-Backend (SystemLicenseGuard) untuk verifikasi.
LICENSE_PRIVATE_KEY_PATH=storage/keys/license_private.key
LICENSE_PUBLIC_KEY_PATH=storage/keys/license_public.key

# HMAC secret webhook push ke client (hub → RME-Backend client).
# Client memverifikasi X-Hub-Signature-256. WAJIB unik per deployment.
SAAS_WEBHOOK_SECRET=

# --- Reverb (WebSocket relay untuk modul Grup) ---------------------------
# Digenerate dengan: php artisan reverb:generate  (atau manual).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=hub-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Server bind (proses reverb:start).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Scaling Reverb via Redis (aman untuk multi-instance).
REVERB_SCALING_ENABLED=true

# --- Grup realtime contract (sisi hub → RME-Backend Modules/Grup) ---------
# Prefix channel HARUS sama dengan default GRUP_REVERB_CHANNEL_PREFIX di client.
# Channel final: private-grup.instance.{instance_id}
GRUP_REVERB_CHANNEL_PREFIX=private-grup.instance.
# contract_version payload event (saat ini 1).
GRUP_CONTRACT_VERSION=1

# --- Service-to-service (hub → instance Modules/Grup) ---------------------
# Secret HMAC that the hub uses to SIGN egress requests to client instances
# (verified by the client's VerifyGroupHubSignature). Material: <ts>\n<request_id>\n<raw_body>.
# Must match GRUP_HUB_HMAC_SECRET on the RME-Backend side.
GRUP_HUB_HMAC_SECRET=
GRUP_HUB_TIMESTAMP_TOLERANCE=300
# Base URL publik hub yang dikonfigurasi di sisi client sebagai GRUP_HUB_URL.
HUB_PUBLIC_URL=https://hub.yourdomain.com

# --- Deployment (docker-compose edge) ------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
